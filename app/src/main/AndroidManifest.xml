<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.verity.tool"
        android:versionCode="10"
        android:versionName="1.6">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".VerityApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VerityTool">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".QuickConfigActivity"
            android:label="@string/title_quick_config"
            android:screenOrientation="portrait" />

        <activity android:name=".MemoryFixActivity"
            android:label="@string/title_memory_fix"
            android:screenOrientation="portrait" />

        <activity android:name=".SettingsActivity"
            android:label="@string/title_settings"
            android:screenOrientation="portrait" />

        <activity android:name=".DisplaySettingsActivity"
            android:label="@string/title_display"
            android:screenOrientation="portrait" />

        <activity android:name=".AboutActivity"
            android:label="@string/title_about"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DownloadActivity"
            android:label="@string/dl_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.verity.tool.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity android:name=".PathSettingsActivity"
            android:label="@string/title_path"
            android:screenOrientation="portrait" />
    </application>

</manifest>
